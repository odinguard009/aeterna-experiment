# GitHub language stats and diffs: built and report files are not source code.
# index.html is built from packages/engine/src + apps/web/src (npm run loop).
index.html linguist-generated
docs/progress.html linguist-generated
docs/roadmap.html linguist-generated
docs/reports/** linguist-generated
# Sources are LF on every OS (CRLF breaks the build: "template marker missing: /*@@CSS@@*/" on a Windows checkout).
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.css text eol=lf
*.json text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
