    "basic-memory": { "command": "<HOME>/.dsh/mcp/venv-basic-memory/Scripts/basic-memory.exe", "args": ["mcp"] },
    "github": { "command": "<HOME>/.dsh/mcp/github/run-github-mcp.cmd", "args": [] },
    "context7": { "command": "cmd", "args": ["/c", "context7-mcp"] },
    "codebase-memory-mcp": { "command": "codebase-memory-mcp", "args": [] }
  }
}
