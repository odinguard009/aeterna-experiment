      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/guardino.fahmi.EMTEKGROUP/AppData/Local/Programs/codebase-memory-mcp/codebase-memory-mcp.exe",
            "args": [
              "hook-augment"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
