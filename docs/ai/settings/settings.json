{
  "advisorModel": "opus",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "autoCompactWindow": 200000
    }
  },
  "hooks": {
    "PreToolUse": [
    {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
            {
                "type": "command",
                "command": "/root/.local/bin/codebase-memory-mcp",
                "args": [
                    "hook-augment"
                ],
                "timeout": 5
            }
        ]
    }
],
    "PostToolUse": [
    {
        "matcher": "Read",
        "hooks": [
            {
                "type": "command",
                "command": "/root/.local/bin/codebase-memory-mcp",
                "args": [
                    "hook-augment"
                ],
                "timeout": 5
            }
        ]
    }
],
    "SessionStart": [
    {
        "matcher": "startup",
        "hooks": [
            {
                "type": "command",
                "command": "/root/.local/bin/codebase-memory-mcp",
                "args": [
                    "hook-augment"
                ],
                "timeout": 5
            }
        ]
    },
    {
        "matcher": "resume",
        "hooks": [
            {
                "type": "command",
                "command": "/root/.local/bin/codebase-memory-mcp",
                "args": [
                    "hook-augment"
                ],
                "timeout": 5
            }
        ]
    },
    {
        "matcher": "clear",
        "hooks": [
            {
                "type": "command",
                "command": "/root/.local/bin/codebase-memory-mcp",
                "args": [
                    "hook-augment"
                ],
                "timeout": 5
            }
        ]
    },
    {
        "matcher": "compact",
        "hooks": [
            {
                "type": "command",
                "command": "/root/.local/bin/codebase-memory-mcp",
                "args": [
                    "hook-augment"
                ],
                "timeout": 5
            }
        ]
    }
],
    "SubagentStart": [
    {
        "matcher": "*",
        "hooks": [
            {
                "type": "command",
                "command": "/root/.local/bin/codebase-memory-mcp",
                "args": [
                    "hook-augment"
                ],
                "timeout": 5
            }
        ]
    }
]
  }
}
